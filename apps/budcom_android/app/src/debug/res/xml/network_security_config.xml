<?xml version="1.0" encoding="utf-8"?>
<!-- Debug allows cleartext so emulator (10.0.2.2) and LAN Connector hosts work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

# BUDCOM backend -- controlled-pilot local environment contract.
#
# Copy to `.env` (already gitignored) or export these directly in your shell before starting
# services. Nothing here is a real secret -- these are LOCAL DEV / CONTROLLED-PILOT values only.
# NEVER put a real production database URL or credential in this file or in `.env`.

# ---------------------------------------------------------------------------
# Trust Service (required to start Trust)
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection string Trust uses for its own schema (business/membership/device
# tables) and, when unset, that Relay also defaults to (see BUDCOM_RELAY_DATABASE_URL below).
# Example for a local Postgres with a dedicated pilot database:
BUDCOM_TRUST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/budcom_pilot

# Optional. Defaults shown.
BUDCOM_TRUST_HOST=127.0.0.1
BUDCOM_TRUST_PORT=8080
BUDCOM_TRUST_DATABASE_POOL_MAX=20

# Optional. Controlled-pilot local signing identity (see
# services/trust/src/persistence/local-signer.ts -- NOT production key management: no HSM, no
# rotation, generated on first use if the key file doesn't exist yet). issuerKeyPath is relative to
# the `backend/` working directory unless given as an absolute path; the directory is created
# automatically. Never commit the generated .pem file (already covered by *.pem in the repo's own
# .gitignore).
BUDCOM_TRUST_ISSUER_ID=budcom-trust-local-pilot
BUDCOM_TRUST_ISSUER_KEY_ID=local-pilot-key-1
BUDCOM_TRUST_ISSUER_KEY_PATH=.local/trust-issuer-key.pem

# ---------------------------------------------------------------------------
# Relay Service (required to start Relay)
# ---------------------------------------------------------------------------

# Optional -- defaults to BUDCOM_TRUST_DATABASE_URL. Only set this if Relay's tables should live in
# a genuinely different database than Trust's (they share one physical schema by design today).
# BUDCOM_RELAY_DATABASE_URL=

# Optional. Defaults shown. Port defaults to 8082, deliberately distinct from Trust's 8080 default
# AND from the Desktop/Connector's own 8080 default (apps/budcom_android's debug builds point the
# Connector at http://10.0.2.2:8080/) -- three local services should never silently share one port.
BUDCOM_RELAY_HOST=127.0.0.1
BUDCOM_RELAY_PORT=8082
BUDCOM_RELAY_DATABASE_POOL_MAX=20

# Optional. Where Relay reaches Trust to fetch (and cache) verification keys. Must match whatever
# Trust is actually listening on.
BUDCOM_TRUST_BASE_URL=http://127.0.0.1:8080
# Must match BUDCOM_TRUST_ISSUER_ID above -- Relay only trusts this one issuer identity.
BUDCOM_TRUST_ISSUER_ID=budcom-trust-local-pilot

# Optional. Relay's own local acceptance-evidence signing identity (see
# services/relay/src/persistence/local-relay-signer.ts -- same "not production key management"
# caveat as Trust's issuer key above).
BUDCOM_RELAY_ID=budcom-relay-local-pilot
BUDCOM_RELAY_ACCEPTANCE_KEY_PATH=.local/relay-acceptance-key.pem

# Optional. Ingress rate limiting (per sender-business/mailbox partition). Defaults shown.
BUDCOM_RELAY_INGRESS_MAX_PER_WINDOW=100
BUDCOM_RELAY_INGRESS_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Dev/test provisioning CLI (services/trust/scripts/dev-provision.ts)
# ---------------------------------------------------------------------------

# Set to "production" to make the dev-provisioning CLI refuse to run at all. Defaults to
# "development" (the CLI runs) if unset. This tool is DEV/TEST-ONLY -- see its own file header.
BUDCOM_RUNTIME_ENV=development

# Optional. Where the CLI persists its JSON-file-backed business/membership/device state between
# separate invocations (create-business, then later register-device, etc). Never committed.
BUDCOM_TRUST_DEV_STATE_PATH=.local/trust-dev-state.json

{
  "name": "@budcom/connector",
  "version": "0.1.0",
  "private": true,
  "description": "Budcom local read-only Tally connector service",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
  "dev": "tsx watch src/main.ts",
  "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "yaml": "^2.5.1"
  }
}
